COMPOSE_PROJECT_NAME=sabz-greenhouse-staging
SITE_DOMAIN=staging.example.com
ACME_EMAIL=admin@example.com
DJANGO_SECRET_KEY=replace-with-a-long-random-staging-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=staging.example.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=300
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
POSTGRES_DB=sabz_greenhouse_staging
POSTGRES_USER=sabz_staging
POSTGRES_PASSWORD=replace-with-a-strong-staging-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
CORS_ALLOWED_ORIGINS=https://staging.example.com
CSRF_TRUSTED_ORIGINS=https://staging.example.com
HTTP_PORT=80
HTTPS_PORT=443
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60
